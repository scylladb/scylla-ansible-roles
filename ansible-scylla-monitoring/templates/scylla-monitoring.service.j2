[Unit]
Description=Scylla Monitoring Stack
Requires=docker.service
PartOf=docker.service
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
{% if not (run_docker_with_sudo | bool) %}
# Match the manual start path: run as the deploy user so root does not execute a
# user-owned wrapper script. When run_docker_with_sudo is set, docker needs root
# and the wrappers are written root-owned, so no User= override is used.
User={{ ansible_user_id }}
Group={{ ansible_user_id }}
{% endif %}
ExecStart={{ scylla_monitoring_start_script_path }}
ExecStop={{ scylla_monitoring_stop_script_path }}

[Install]
WantedBy=multi-user.target
